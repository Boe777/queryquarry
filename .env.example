# Read-only role, pooled connection. Used by the application.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/chinook?sslmode=require

# Owner role, direct connection. Used for maintenance only, never by the app.
DATABASE_ADMIN_URL=postgresql://user:password@host.region.aws.neon.tech/chinook?sslmode=require

# https://console.groq.com/keys
GROQ_API_KEY=

# https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b